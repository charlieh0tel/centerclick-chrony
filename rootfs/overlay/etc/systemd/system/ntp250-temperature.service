[Unit]
Description=NTP250 averaged SoC temperature for chrony tempcomp
Before=chrony.service

[Service]
ExecStart=/usr/local/sbin/ntp250-temperature
RuntimeDirectory=ntp250
RuntimeDirectoryPreserve=yes
Restart=on-failure
# The TSADC module may load after this starts.
RestartSec=5

[Install]
WantedBy=multi-user.target
