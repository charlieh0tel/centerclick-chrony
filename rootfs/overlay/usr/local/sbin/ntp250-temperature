#!/bin/sh
# SoC temperature for chrony tempcomp: the mean of both TSADC zones
# (logic, CPU) over SAMPLES one-second readings, in millidegrees C,
# written atomically to $RUNTIME_DIRECTORY/temperature.  One reading
# has a 0.45 C step and 0.55 C sd (NOTES.md "Temperature").
set -eu

SAMPLES=32
zones="/sys/class/thermal/thermal_zone0/temp /sys/class/thermal/thermal_zone1/temp"
out=${RUNTIME_DIRECTORY:?}/temperature

# sum_zones: print the sum of the current zone readings.
sum_zones() {
    total=0
    for zone in $zones; do
        read -r value <"$zone"
        total=$((total + value))
    done
    echo "$total"
}

publish() {
    echo "$1" >"$out.tmp"
    mv "$out.tmp" "$out"
}

nzones=$(echo "$zones" | wc -w)
# First value from one reading, so chrony has a file to read at once.
publish $(($(sum_zones) / nzones))
while :; do
    sum=0
    i=0
    while [ "$i" -lt "$SAMPLES" ]; do
        sum=$((sum + $(sum_zones)))
        i=$((i + 1))
        sleep 1
    done
    publish $((sum / (SAMPLES * nzones)))
done
