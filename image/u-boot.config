# Merged over the U-Boot defconfig by image/build.sh.

# Console on uart0 (module header 1) and uart2 (carrier micro-USB), both
# at CONFIG_BAUDRATE (1500000).  preboot adds uart2 once U-Boot proper
# runs; earlier output appears on uart0 only.
CONFIG_CONSOLE_MUX=y
# Probe uart2 too; otherwise it is not a stdio device and the mux skips it.
CONFIG_SERIAL_PROBE_ALL=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_USE_PREBOOT=y
# preboot also sets bootcmd and altbootcmd, so a saved environment cannot
# keep old ones: bootcmd boots extlinux.conf, altbootcmd (boot count past
# bootlimit) fallback.conf, both from partition 1 of the card (mmc 1);
# either resets if the boot fails, which counts another boot.
CONFIG_PREBOOT="setenv stdin serial@ff0a0000,serial@ff0c0000; setenv stdout serial@ff0a0000,serial@ff0c0000; setenv stderr serial@ff0a0000,serial@ff0c0000; setenv bootcmd 'sysboot mmc 1:1 any ${scriptaddr} /boot/extlinux/extlinux.conf; reset'; setenv altbootcmd 'sysboot mmc 1:1 any ${scriptaddr} /boot/extlinux/fallback.conf; reset'"
CONFIG_CMD_SYSBOOT=y

# Boot extlinux only: no EFI loader, so no EFI boot manager or EFI
# bootmeth tried before extlinux.
# CONFIG_EFI_LOADER is not set

# Environment on the card, two copies, in partition 3 (uboot) after U-Boot
# (image/build.sh check_uboot_env; /etc/fw_env.config).  Written only
# while a kernel is on trial (boot count).  ENV_APPEND: a saved
# environment adds to the built-in one, so one fw_setenv wrote on a blank
# card (only bootcount, upgrade_available) still boots.
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=1
CONFIG_ENV_SIZE=0x8000
CONFIG_ENV_OFFSET=0xF00000
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET_REDUND=0xF10000
CONFIG_ENV_APPEND=y

# Boot count: while upgrade_available=1 (ntp250-extlinux), every boot
# counts; past bootlimit, altbootcmd runs (ntp250-boot-ok ends the trial).
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3

# Watchdog started by U-Boot, so a hang before systemd also resets (and
# counts).  DW WDT at the 100 MHz bus clock: at most 2^31 cycles, 21.5 s.
# Linux dw_wdt feeds it until systemd opens it (WATCHDOG_HANDLE_BOOT_ENABLED).
CONFIG_WDT=y
CONFIG_DESIGNWARE_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=20000
