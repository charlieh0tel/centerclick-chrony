#!/bin/sh
# Timing tweaks, as the stock firmware applied them (cc_monitor:2202-2208).
# Measurements: NOTES.md "Timing tweaks".
set -eu

# Keep the cores out of PSCI cpu-sleep (wake latency 370 us), which
# delays the PPS and network interrupts; WFI (1 us) stays.
for state in /sys/devices/system/cpu/cpu*/cpuidle/state1/disable; do
    echo 1 >"$state"
done

# Fixed 1008 MHz: less PPS and NTP interrupt latency than schedutil,
# which sits at 600 MHz.
for governor in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    echo performance >"$governor"
done

# Ethernet interrupt on CPU3, away from the PPS and GPS UART interrupts.
irq=$(awk '$NF == "end0" { sub(":", "", $1); print $1 }' /proc/interrupts)
[ -n "$irq" ] || { echo "ntp250-tuning: no end0 interrupt" >&2; exit 1; }
echo 3 >"/proc/irq/$irq/smp_affinity_list"

# Ethernet RX interrupt coalescing at the stmmac minimum, 82 us (16
# RIWT units; mainline default 819 us; stock 164 us).
ethtool -C end0 rx-usecs 82
