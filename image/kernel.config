# Merged over arm64 defconfig by image/build.sh.

# PPS from the GPS timepulse
CONFIG_PPS=y
CONFIG_PPS_CLIENT_GPIO=y

# Carrier RTC and EEPROM
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_EEPROM_AT24=y

# Ethernet: RK3308 GMAC, RTL8201F PHY
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y

# Console and GPS UARTs, SD card
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# LEDs, button, GPIO lines
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_GPIO_CDEV=y

# Timekeeping
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Firewall (package/ntp250-config/root/usr/lib/ntp250/nftables.conf): inet tables, conntrack
# state, notrack
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
