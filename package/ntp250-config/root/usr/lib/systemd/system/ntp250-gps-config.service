[Unit]
Description=Configure the u-blox GPS (NOTES.md "GPS configuration")
After=ntp250-gpio-init.service
Wants=ntp250-gpio-init.service
Before=gpsd.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/usr/lib/ntp250/gps-config.env
EnvironmentFile=-/etc/default/ntp250-gps-config
ExecStart=/usr/sbin/ntp250-gps-config

[Install]
WantedBy=multi-user.target
