#!/bin/sh
# Configure the u-blox MAX-M8Q on uart1 before gpsd starts.  The M8Q has
# no flash: settings survive only in battery-backed RAM (supercap, about
# 3 h), so this runs at every boot.  Settings and reasons: NOTES.md "GPS
# configuration".  Constellations: NTP250_GNSS
# (/usr/lib/ntp250/gps-config.env).
set -eu

dev=/dev/ttyS1
# ubxtool's constellation names; GPS also sets QZSS.
all_gnss='GPS GALILEO GLONASS BEIDOU SBAS'

[ -n "${NTP250_GNSS:-}" ] || { echo "ntp250-gps-config: NTP250_GNSS empty or unset" >&2; exit 1; }
for g in $NTP250_GNSS; do
    case " $all_gnss " in
    *" $g "*) ;;
    *) echo "ntp250-gps-config: unknown constellation $g in NTP250_GNSS" >&2; exit 1 ;;
    esac
done

ubx() {
    ubxtool -f "$dev" -P 18 -w 1 "$@"
}

# Tries per setting: an acknowledgement is occasionally lost (SAVE, at
# boot); every setting is idempotent.
tries=3

# apply ARGS...: send one setting at 115200, up to $tries times; fail
# unless acknowledged.
apply() {
    for try in $(seq "$tries"); do
        ubx -s 115200 "$@" 2>&1 | grep -q UBX-ACK-ACK && return 0
        echo "ntp250-gps-config: no ACK for $* (try $try of $tries)" >&2
    done
    exit 1
}

# Factory defaults from either speed (only one gets through); afterwards
# the receiver runs at 9600.
ubx -s 115200 -p RESET >/dev/null 2>&1 || true
ubx -s 9600 -p RESET >/dev/null 2>&1 || true
sleep 2
ubx -s 9600 -S 115200 >/dev/null 2>&1

for g in $all_gnss; do
    case " $NTP250_GNSS " in
    *" $g "*) apply -e "$g" ;;
    *) apply -d "$g" ;;
    esac
done
apply -p MODEL,2
apply -p CFG-MSG,0xf0,0x01,0
apply -p CFG-MSG,0xf0,0x02,0
apply -p CFG-MSG,0xf0,0x03,0
apply -p CFG-MSG,0xf0,0x05,0
apply -p CFG-MSG,0xf0,0x08,1
apply -p SAVE
