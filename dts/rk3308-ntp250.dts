/*
 * CenterClick NTP250 rev 10: Radxa ROCK Pi S V1.3 on the CHRONOS V10
 * carrier.  Pin sources: NOTES.md "Pin map" (stock DTB
 * rk3308-rock-pi-s-chronos.dtb).
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "rk3308-rock-pi-s.dts"

/ {
	model = "CenterClick NTP250 (Radxa ROCK Pi S)";
	compatible = "centerclick,ntp250", "radxa,rockpis", "rockchip,rk3308";

	aliases {
		rtc0 = &pcf8563;
	};

	carrier-leds {
		compatible = "gpio-leds";

		led-system {
			label = "ntp250:green:system";
			gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		led-sd {
			label = "ntp250:green:sd";
			gpios = <&gpio2 RK_PA5 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "mmc1";
		};

		led-ntp {
			label = "ntp250:green:ntp";
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_front_pin>;

		/* SW1: high while pressed, pulled down when idle (measured). */
		button-front {
			label = "front";
			linux,code = <KEY_PROG1>;
			gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		};
	};

	pps {
		compatible = "pps-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pps_pin>;
		gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * Carrier signals by name, for libgpiod.  Outputs (gps-nreset,
 * gps-reset, hdr-ppsout-en) stay free for userspace: ntp250-gpio-init
 * sets their idle levels at boot, ntp250-gps-reset pulses them.  Other
 * names follow the upstream ROCK Pi S DTS.
 */
&gpio0 {
	gpio-line-names =
		/* GPIO0_A0 - A7 */
		"", "", "", "", "", "", "", "",
		/* GPIO0_B0 - B7 */
		"", "", "", "header1-pin3 [GPIO0_B3]",
		"header1-pin5 [GPIO0_B4]", "", "",
		"barrel-mech",
		/* GPIO0_C0 - C7 */
		"header1-pin13 [GPIO0_C0]", "rtc-int", "", "", "",
		"", "", "",
		/* GPIO0_D0 - D7 */
		"", "", "", "", "", "", "", "";
};

&gpio2 {
	gpio-line-names =
		/* GPIO2_A0 - A7 */
		"header1-pin10 [GPIO2_A0]", "header1-pin8 [GPIO2_A1]",
		"", "",
		"hdr-ppsout-en", "led-sd",
		"header2-pin46 [GPIO2_A6]", "led-system",
		/* GPIO2_B0 - B7 */
		"header2-pin45 [GPIO2_B0]", "button-front",
		"poe-sense", "header2-pin44 [GPIO2_B3]",
		"header2-pin43 [GPIO2_B4]", "led-ntp",
		"gps-pps", "gps-nreset",
		/* GPIO2_C0 - C7 */
		"gps-reset", "", "", "", "", "", "", "",
		/* GPIO2_D0 - D7 */
		"", "", "", "", "", "", "", "";
};

/*
 * ROCK Pi S V1.3: vccio2 (UART0, carrier GPIO2 signals) and vccio3 run at
 * 1.8 V, as in the stock DTB.  The upstream board DTS says 3.3 V; with
 * vccio2 in 3.3 V mode, UART0 TX stays silent.
 */
&io_domains {
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vcc_1v8>;
};

/* No eMMC or SD-NAND fitted on this module. */
&emmc {
	status = "disabled";
};

&i2c1 {
	clock-frequency = <400000>;

	pcf8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC1 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <0>;
	};
};

&pinctrl {
	ntp250 {
		pps_pin: pps-pin {
			rockchip,pins = <2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		button_front_pin: button-front-pin {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		rtc_int: rtc-int {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

/* GPS.  TX/RX only: uart1's RTS/CTS pins are uart2m0 (CH340N console). */
&uart1 {
	pinctrl-0 = <&uart1_xfer>;
	status = "okay";
};

/* CH340N, carrier micro-USB "Console". */
&uart2 {
	status = "okay";
};

/*
 * Unused Wi-Fi (SDIO) and Bluetooth (uart4), disabled as in the stock DTB.
 * sdio_pwrseq stays: it holds the RTL8723DS in reset.
 */
&sdio {
	status = "disabled";
};

&uart4 {
	status = "disabled";
};
