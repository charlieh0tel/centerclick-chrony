+++ b/drivers/clk/rockchip/clk_rk3308.c
@@ -1126,9 +1126,25 @@
 }
 #endif
 
+/*
+ * NTP250: clocks are on from reset and this driver has no gates; report
+ * the watchdog clock enabled so designware_wdt probes (it fails on
+ * -ENOSYS).  Other clocks keep -ENOSYS, as without an enable op.
+ */
+static int rk3308_clk_enable(struct clk *clk)
+{
+	switch (clk->id) {
+	case PCLK_WDT:
+		return 0;
+	default:
+		return -ENOSYS;
+	}
+}
+
 static struct clk_ops rk3308_clk_ops = {
 	.get_rate = rk3308_clk_get_rate,
 	.set_rate = rk3308_clk_set_rate,
+	.enable = rk3308_clk_enable,
 #if CONFIG_IS_ENABLED(OF_REAL)
 	.set_parent = rk3308_clk_set_parent,
 #endif
